#!/bin/bash

# omarchy:summary=Install an application in the tablet's terminal
# omarchy:args=<display-name> <space-separated-packages>

set -euo pipefail

if (($# != 2)) || [[ -z $1 ]]; then
  echo 'Usage: omarchy-install-app <display-name> <space-separated-packages>' >&2
  exit 2
fi
IFS=$' \t\n' read -r -d '' -a packages <<< "$2" || true
if ((${#packages[@]} == 0)); then
  echo 'At least one package is required.' >&2
  exit 2
fi

# Quote every value independently; package lists are split, never evaluated or
# glob-expanded. In particular, callers already pass multi-package strings.
printf -v command 'printf "Installing %%s\\n" %q; omarchy-pkg-add' "$1"
printf -v package_args ' %q' "${packages[@]}"
command+="$package_args && printf 'Installed successfully.\\n'"
exec omarchy-launch-floating-terminal-with-presentation "$command"
