[Unit]
Description=Initialize the pacman keyring
# build-rootfs ships no keyring so each device generates its own local key.
After=local-fs.target
Before=greetd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/pacman-key --init
# Repeat population on every boot, including after interrupted initialization.
ExecStart=/usr/bin/pacman-key --populate archlinuxarm omarchy

[Install]
WantedBy=multi-user.target
